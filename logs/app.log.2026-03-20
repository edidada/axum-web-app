else sc.setmeal_id
end as item_id,
case
when sc.dish_id is not null then d.name
else s.name
end as item_name,
case
when sc.dish_id is not null then d.image
else s.image
end as item_image,
case
when sc.dish_id is not null then d.price
else s.price
end as item_price,
case
when sc.dish_id is not null then 'dish'
else 'setmeal'
end as item_type
from shopping_cart sc
left join dish d on sc.dish_id = d.id
left join setmeal s on sc.setmeal_id = s.id order by sc.create_time desc` []
